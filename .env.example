TELEGRAM_BOT_TOKEN=123456789:PUT_YOUR_TOKEN_HERE
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Admin Telegram ID lari (vergul bilan): 123456789,987654321
ADMIN_IDS=
# Bir martalik admin kodi (ixtiyoriy). Bo'sh bo'lsa /admin faqat ADMIN_IDS uchun.
ADMIN_SECRET=

# PostgreSQL (parolni shu yerga yozing, hech qaerga sizlitsiz)
DATABASE_URL=postgresql://talaba_bot:PAROLNI_YOZING@localhost:5432/talaba_bot

# Bepul foydalanuvchi uchun kunlik AI hujjatlar limiti
DAILY_LIMIT=3
# Bir vaqtda ishlaydigan Gemini so'rovlar soni
GEMINI_MAX_CONCURRENT=2

# Pro paket (bir martalik): PREMIUM_DAYS kun ichida PRO_WORD ta Word + PRO_SLIDE ta slayd + quiz tahlili
PREMIUM_DAYS=30
PRO_WORD=5
PRO_SLIDE=5
# Qo'lda to'lov kartasi — FAQAT shu faylda, git ga tushmaydi!
# PAYMENT_CARD ni to'ldirsangiz "Sotib olish" tugmasi karta va summani ko'rsatadi
PAYMENT_CARD=
PAYMENT_HOLDER=
PAYMENT_AMOUNT=15000
